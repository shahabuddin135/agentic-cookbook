# Agentic Cookbook — Frontend environment template.
# Copy to .env.local and fill with real values (.env.local is gitignored).
# SECURITY: never commit real secrets. Tracked files use placeholders only.

# FastAPI backend base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# This Next.js app's own URL — Better Auth uses it as baseURL and to serve JWKS
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth server secret (generate a strong random value)
BETTER_AUTH_SECRET={BETTER_AUTH_SECRET}

# Neon Postgres POOLER connection string (serverless) for Better Auth tables
DATABASE_URL={NEON_POOLER_URL}
